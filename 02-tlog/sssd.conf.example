# /etc/sssd/sssd.conf
# Exemplo de configuracao do SSSD para gravacao de sessoes com tlog
#
# IMPORTANTE: Este metodo so funciona quando o SSSD e responsavel
# pela autenticacao dos usuarios (LDAP, Active Directory, etc).
#
# Para usuarios puramente locais (/etc/passwd), use o metodo de
# trocar o shell do usuario para /usr/bin/tlog-rec-session.
#
# Se voce ja usa SSSD para autenticacao centralizada, adicione
# a secao [session_recording] abaixo ao seu sssd.conf existente.

[session_recording]
# scope: none, some, ou all
scope = some

# Usuarios a serem gravados (quando scope = some)
users = root, admin

# Grupos a serem gravados (quando scope = some)
groups = wheel
