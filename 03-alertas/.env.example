# =============================================================================
# Graylog + OpenSearch + MongoDB - Configuração de Alertas
# CSI do Linux - Parte 03: Alertas Inteligentes
# =============================================================================

# -----------------------------------------------------------------------------
# Configurações base (do artigo 01)
# -----------------------------------------------------------------------------

# Senha de admin do Graylog (mínimo 16 caracteres)
GRAYLOG_ROOT_PASSWORD_SHA2=<sha256_da_senha>

# Segredo para tokens (gere com: openssl rand -hex 32)
GRAYLOG_PASSWORD_SECRET=<segredo_de_32_chars>

# URL externa (para links em alertas)
GRAYLOG_HTTP_EXTERNAL_URI=http://localhost:9000/

# Timezone
GRAYLOG_ROOT_TIMEZONE=America/Sao_Paulo

# -----------------------------------------------------------------------------
# Configurações de Email (SMTP)
# -----------------------------------------------------------------------------

# Habilitar envio de emails
GRAYLOG_TRANSPORT_EMAIL_ENABLED=true

# Servidor SMTP
GRAYLOG_TRANSPORT_EMAIL_HOSTNAME=smtp.seudominio.com.br
GRAYLOG_TRANSPORT_EMAIL_PORT=587

# Autenticação SMTP
GRAYLOG_TRANSPORT_EMAIL_USE_AUTH=true
GRAYLOG_TRANSPORT_EMAIL_AUTH_USERNAME=alertas@seudominio.com.br
GRAYLOG_TRANSPORT_EMAIL_AUTH_PASSWORD=senha_do_email

# Usar TLS (recomendado)
GRAYLOG_TRANSPORT_EMAIL_USE_TLS=true

# Remetente padrão
GRAYLOG_TRANSPORT_EMAIL_FROM_EMAIL=graylog@seudominio.com.br

# URL do Graylog para links nos emails
GRAYLOG_TRANSPORT_EMAIL_WEB_INTERFACE_URL=https://graylog.seudominio.com.br

# -----------------------------------------------------------------------------
# Configurações de Webhook (opcional)
# -----------------------------------------------------------------------------

# Slack Webhook URL
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# Teams Webhook URL
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/xxx

# PagerDuty Integration Key
# PAGERDUTY_INTEGRATION_KEY=xxx

# -----------------------------------------------------------------------------
# OpenSearch (do artigo 01)
# -----------------------------------------------------------------------------

OPENSEARCH_INITIAL_ADMIN_PASSWORD=<senha_admin_opensearch>
