# Graylog - Configurações
# Copie este arquivo para .env e ajuste os valores

# Frase secreta para criptografia (mínimo 16 caracteres)
# Gere uma com: openssl rand -base64 32
GRAYLOG_PASSWORD_SECRET=troque_por_uma_frase_secreta_com_pelo_menos_16_caracteres

# Senha do usuário admin em SHA256
# Gere com: printf '%s' "SuaSenhaForte123" | sha256sum | cut -d' ' -f1
# IMPORTANTE: Use printf, não echo -n. Evite ! na senha pra não ter problemas.
GRAYLOG_ROOT_PASSWORD_SHA2=troque_pelo_hash_sha256_da_sua_senha

# IP ou hostname do servidor (usado para acessar a interface web)
GRAYLOG_HTTP_EXTERNAL_URI=http://SEU_IP:9000/

# Senha inicial do OpenSearch (exigida a partir da versão 2.12)
# Precisa ter pelo menos 8 caracteres, uma maiúscula, uma minúscula, um número e um caractere especial
# Exemplo: S3cur3P@ssw0rd1Lab
OPENSEARCH_INITIAL_ADMIN_PASSWORD=troque_por_uma_senha_forte
